{
  "manifest_version": 3,
  "name": "Giftuber",
  "version": "1.0.2",
  "description": "YouTube yorumlarına GIF ekle ve yorumlardaki GIF bağlantılarını direkt GIF olarak gör.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://tenor.com/*", "https://tenor.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
